# ----------- Unity-generated / locally-regenerated -----------
# These are recreated by Unity from the source assets. Never commit.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/

# Asset meta files for files that have not yet been imported are auto-generated.
# Real .meta files for tracked assets MUST be committed (Unity uses them for
# guid-stable references across machines). The default rules below already
# do the right thing -- we don't need to ignore *.meta.

# Recorder / capture outputs
[Rr]ecordings/

# ----------- Build outputs (APK / AAB) -----------
# Builds are big binary blobs that change every build. Don't commit them.
# If you want to share builds, attach them to a GitHub Release instead.
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics / Firebase
crashlytics-build.properties

# ----------- Visual Studio / Rider / VS Code IDE files -----------
# These are auto-generated by Unity from the project structure.
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# JetBrains Rider
.idea/

# Visual Studio Code
.vscode/

# ----------- OS junk -----------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ----------- Backup / merge files -----------
*.swp
*~
*.orig
*.rej

# ----------- Unity Cloud Build / CI artifacts -----------
sysinfo.txt
*.stackdump
